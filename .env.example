# Required.
DATABASE_URL=postgresql://kpi_crawler:kpi_crawler@localhost:5432/kpi_crawler

# Optional. Defaults shown.
LOG_LEVEL=INFO
ARTIFACT_STORAGE_DIR=.data/artifacts
EXPORT_DIR=exports
ACQUISITION_TIMEOUT_SECONDS=10
ACQUISITION_RETRIES=2
MAX_ARTIFACT_BYTES=50000000
ALLOWED_CONTENT_TYPES=application/pdf
CRAWL_MAX_DEPTH=2
CRAWL_MAX_ARTIFACTS=50
